# Muse-IPTV 环境变量示例（复制为 .env 后按需修改）
# 作者: Passwd Word
#
# 对外只暴露网关一个端口（默认 :8081）：门户 /、后台 /admin、
# API /api/* 与 /healthz 全走它；API :8080 与门户/后台 :18081/:18082 只绑本机。

# 数据库：默认 SQLite（单机演示）；生产改 postgres://user:pass@host:5432/iptv 或 mysql://…
DATABASE_URL=sqlite://./data/iptv.db
# REDIS_URL=redis://127.0.0.1:6379
# PLAY_SECRET=  # 不填/留空时容器入口自动处理：先读数据卷 /app/data/.secrets，
# ADMIN_SECRET= # 没有则生成一次并写入该文件持久化复用（只记日志“已生成”，不打印值）。
# 生产建议固定写死。轮换：删 /app/data/.secrets + 重启，全体会话随之失效。
# 注意：API 是 fail-closed——密钥最终仍为空时拒绝启动，不再静默随机生成。
PORTAL_BASE_URL=http://127.0.0.1:8081
# API 只走内部（网关转发到它）；改端口要同步改 IPTV_API_BASE。
BIND_ADDR=127.0.0.1:8080
# 网关对外监听地址；compose 用 IPTV_PORT 改映射端口。
GATEWAY_BIND_ADDR=0.0.0.0:8081
# 门户/后台内部监听地址（各一个变量；不设则用 LEPTOS_SITE_ADDR，默认 127.0.0.1:3000）。
IPTV_PORTAL_ADDR=0.0.0.0:18081
IPTV_ADMIN_ADDR=0.0.0.0:18082
# 网关转发目标（默认与上面两个内部地址一致，一般不用改）。
# IPTV_API_BASE=http://127.0.0.1:8080
# IPTV_PORTAL_BASE=http://127.0.0.1:18081
# IPTV_ADMIN_BASE=http://127.0.0.1:18082
# compose 映射到宿主的端口（只映射网关一个）。
IPTV_PORT=8081
# 台标转存对象存储（§7.2，m9）：四项全配才启用；缺一即不转存，
# logo_url 保持上游直链。密钥只放 .env / 环境变量，绝不进代码或仓库。
# S3_ENDPOINT：S3 兼容服务地址（MinIO / R2 / OSS 等），如 https://s3.example.com
# S3_BUCKET：桶名；S3_REGION 缺省 us-east-1；S3_PUBLIC_BASE_URL 可选
# （公开访问前缀，如 CDN 域名；不配则用 {endpoint}/{bucket}/{key}）。
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=iptv-logos
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# CORS 允许源（§13，m14）：逗号分隔，如 https://app.example.com,https://tv.example.com。
# 默认空 = 只同源（部署是单端口网关同源，浏览器根本不走 CORS）。
# 注意：即使配了源，也永远不配 allow_credentials——会话 Cookie 只走
# 同源网关（SameSite=Lax），跨域凭据访问不在设计内；配了源也只放行
# 无凭据的跨域读请求，写请求仍须过 CSRF 双提交/Origin 检查。
# IPTV_CORS_ORIGINS=https://app.example.com
# 首次启动建超管（库里已有管理员时忽略；密码不打日志）
IPTV_ADMIN_USER=admin
IPTV_ADMIN_PASSWORD=change-me-please
